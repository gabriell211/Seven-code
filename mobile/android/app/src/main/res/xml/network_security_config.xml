<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only the Code OSS server inside this phone can use cleartext HTTP.
         Public/remote HTTP endpoints remain blocked; the browser bridge is
         still origin-scoped to the exact running loopback server. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
