{
  "name": "Seven Code Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#8C6DFF",
    "foreground": "#E7E9FA",
    "editor.background": "#0B1124",
    "editor.foreground": "#E7E9FA",
    "editorLineNumber.foreground": "#647093",
    "activityBar.background": "#0A1022",
    "activityBar.foreground": "#D7E0FF",
    "activityBarBadge.background": "#7D58FF",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#101932",
    "sideBar.foreground": "#C9D3F5",
    "sideBarTitle.foreground": "#D9E2FF",
    "titleBar.activeBackground": "#101735",
    "titleBar.activeForeground": "#F0F4FF",
    "statusBar.background": "#502FDB",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.debuggingBackground": "#4D22BC",
    "tab.activeBackground": "#0B1124",
    "tab.inactiveBackground": "#101932",
    "tab.activeBorderTop": "#15D9EE",
    "panel.background": "#0D1630",
    "button.background": "#6D46E8",
    "button.foreground": "#FFFFFF",
    "input.background": "#182440",
    "terminal.background": "#0B1124",
    "terminal.foreground": "#EBE8FF"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#BC8CFF"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#7CE8E1"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#64D3FF"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#7383A8",
        "fontStyle": "italic"
      }
    }
  ]
}
